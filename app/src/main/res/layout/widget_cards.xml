<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:padding="@dimen/widget_padding">

    <GridView
        android:id="@+id/widget_cards_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnWidth="@dimen/widget_card_column_width"
        android:horizontalSpacing="@dimen/widget_card_spacing"
        android:numColumns="auto_fit"
        android:stretchMode="columnWidth"
        android:verticalSpacing="@dimen/widget_card_spacing" />

    <TextView
        android:id="@+id/widget_cards_empty_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_cards_empty_text"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/widget_text_color" />

</FrameLayout>
