<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/cardholder_card_view_layout_margin"
    app:cardBackgroundColor="?colorSurfaceContainer"
    app:cardCornerRadius="@dimen/spec_item_corner_radius"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spec_item_content_padding">

        <ImageView
            android:id="@+id/item_spec_barcode_image"
            android:layout_width="@dimen/spec_item_image_width"
            android:layout_height="@dimen/spec_item_image_height"
            android:background="@drawable/bg_white_square"
            android:padding="@dimen/spec_item_image_padding"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            tools:src="@sample/sample_cards.json/cards/image" />

        <TextView
            android:id="@+id/item_spec_barcode_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spec_item_content_padding"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:layout_constraintBottom_toTopOf="@id/item_spec_barcode_characters_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/item_spec_barcode_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="@sample/sample_barcode_format_names" />

        <TextView
            android:id="@+id/item_spec_barcode_characters_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintBottom_toTopOf="@id/item_spec_barcode_length_text"
            app:layout_constraintEnd_toEndOf="@id/item_spec_barcode_name_text"
            app:layout_constraintStart_toStartOf="@id/item_spec_barcode_name_text"
            app:layout_constraintTop_toBottomOf="@id/item_spec_barcode_name_text"
            tools:text="Valid characters: 0–9" />

        <TextView
            android:id="@+id/item_spec_barcode_length_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/item_spec_barcode_name_text"
            app:layout_constraintStart_toStartOf="@id/item_spec_barcode_name_text"
            app:layout_constraintTop_toBottomOf="@id/item_spec_barcode_characters_text"
            tools:text="Length: 13" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
