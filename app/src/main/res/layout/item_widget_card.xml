<?xml version="1.0" encoding="utf-8"?>
<!-- A card in the widget: the background is tinted with the card color by the widget -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/item_widget_card_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_card"
        tools:ignore="ContentDescription"
        tools:tint="@sample/sample_cards.json/cards/color" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/widget_card_content_padding">

        <ImageView
            android:id="@+id/item_widget_card_logo_image"
            android:layout_width="@dimen/widget_card_logo_size"
            android:layout_height="@dimen/widget_card_logo_size"
            android:background="@drawable/bg_widget_card_logo"
            android:padding="@dimen/widget_card_logo_padding"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_qr_code" />

        <TextView
            android:id="@+id/item_widget_card_name_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="1"
            android:paddingTop="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            tools:text="@sample/sample_cards.json/cards/name" />

    </LinearLayout>

</FrameLayout>
