<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyCardholder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cardholder_color_primary_day</item>
        <item name="colorOnPrimary">@color/cardholder_color_on_primary_day</item>
        <item name="colorPrimaryContainer">@color/cardholder_color_primary_container_day</item>
        <item name="colorOnPrimaryContainer">@color/cardholder_color_on_primary_container_day</item>
        <item name="colorSecondary">@color/cardholder_color_secondary_day</item>
        <item name="colorSecondaryContainer">@color/cardholder_color_secondary_container_day</item>
        <item name="colorOnSecondaryContainer">@color/cardholder_color_on_secondary_container_day</item>
        <item name="colorError">@color/cardholder_color_error_day</item>
        <item name="colorErrorContainer">@color/cardholder_color_error_container_day</item>
        <!-- Neutrals, otherwise Material 3 uses its purple tinted default ones -->
        <item name="android:colorBackground">@color/cardholder_color_background_day</item>
        <item name="colorOnBackground">@color/cardholder_color_on_background_day</item>
        <item name="colorSurface">@color/cardholder_color_surface_day</item>
        <item name="colorOnSurface">@color/cardholder_color_on_surface_day</item>
        <item name="colorSurfaceVariant">@color/cardholder_color_surface_variant_day</item>
        <item name="colorOnSurfaceVariant">@color/cardholder_color_on_surface_variant_day</item>
        <item name="colorSurfaceContainerLowest">@color/cardholder_color_surface_container_lowest_day</item>
        <item name="colorSurfaceContainerLow">@color/cardholder_color_surface_container_low_day</item>
        <item name="colorSurfaceContainer">@color/cardholder_color_surface_container_day</item>
        <item name="colorSurfaceContainerHigh">@color/cardholder_color_surface_container_high_day</item>
        <item name="colorSurfaceContainerHighest">@color/cardholder_color_surface_container_highest_day</item>
        <item name="colorSurfaceDim">@color/cardholder_color_surface_dim_day</item>
        <item name="colorSurfaceBright">@color/cardholder_color_surface_bright_day</item>
        <item name="colorSurfaceInverse">@color/cardholder_color_inverse_surface_day</item>
        <item name="colorOnSurfaceInverse">@color/cardholder_color_inverse_on_surface_day</item>
        <item name="colorOutline">@color/cardholder_color_outline_day</item>
        <item name="colorOutlineVariant">@color/cardholder_color_outline_variant_day</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Navigation bar -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:navigationBarColor">@color/cardholder_color_surface_container_day</item>
    </style>

    <style name="Theme.MyCardholder.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">?android:windowBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/avd_splash</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">900</item>
        <item name="postSplashScreenTheme">@style/Theme.MyCardholder</item>
    </style>

</resources>
